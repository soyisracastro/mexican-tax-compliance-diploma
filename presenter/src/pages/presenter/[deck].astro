---
import Base from "../../layouts/Base.astro";
import BlockIcon from "../../components/BlockIcon.astro";
import SearchPalette from "../../components/SearchPalette.astro";
import Spotlight from "../../components/Spotlight.astro";
import { loadAllDecks } from "../../lib/parseSlides";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
  return loadAllDecks().map((deck) => ({
    params: { deck: deck.slug },
    props: { deck },
  }));
}) satisfies GetStaticPaths;

const { deck } = Astro.props;
const slides = deck.slides;
const initialSlide = slides[0];

// Recolectar iconos únicos por bloque para pre-renderizar
const uniqueIcons = Array.from(
  new Set(slides.map((s) => s.blockIcon).filter((x): x is string => !!x))
);
---

<Base title={`${deck.title} — Presentador`} bodyClass="bg-background">
  <div id="presenter-root" data-deck-slug={deck.slug} data-total={slides.length}>
    <!-- HUD superior -->
    <div class="hud hud--top-left">
      <span class="hud__icon" id="hud-icon" aria-hidden="true"></span>
      <span class="hud__block" id="hud-block">{initialSlide?.blockTitle ?? ""}</span>
    </div>
    <div class="hud hud--top-right">
      <span class="hud__count">
        <span id="hud-current">1</span> / {slides.length}
      </span>
    </div>

    <!-- Iconos pre-renderizados (ocultos); el JS copia el SVG al HUD según el bloque -->
    <div id="icon-registry" hidden>
      {uniqueIcons.map((icon) => (
        <span data-icon={icon}>
          <BlockIcon name={icon} size={14} strokeWidth={2.2} />
        </span>
      ))}
    </div>

    <!-- Slides (todos renderizados, solo uno visible) -->
    {slides.map((slide, i) => (
      <section
        class="slide-shell"
        data-slide-index={i}
        data-block-title={slide.blockTitle ?? ""}
        data-block-icon={slide.blockIcon ?? ""}
        style={i === 0 ? "" : "display:none"}
      >
        <article class="slide">
          <h1 class="slide__title">{slide.title}</h1>
          {slide.contentHtml && (
            <div class="slide__body" set:html={slide.contentHtml} />
          )}
        </article>
      </section>
    ))}

    <!-- Barra de progreso -->
    <div class="progress">
      <div class="progress__fill" id="progress-fill" style="width: 0%"></div>
    </div>

    <!-- Overlay del buffer numérico "Ir a slide N" -->
    <div class="number-overlay" id="number-overlay" hidden>
      <span class="number-overlay__label">Ir a slide</span>
      <span class="number-overlay__value" id="number-overlay-value"></span>
      <span class="number-overlay__cursor"></span>
    </div>

    <!-- Controles keyboard hint -->
    <div class="hud hud--bottom-right">
      ← → · N notas · O overview · ⌘K buscar · F foco
    </div>
  </div>

  <Spotlight />
  <SearchPalette deckSlug={deck.slug} slides={slides} />

  <script>
    import { createController } from "../../scripts/presenter-controller";

    const root = document.getElementById("presenter-root")!;
    const slug = root.dataset.deckSlug!;
    const total = parseInt(root.dataset.total!, 10);
    const sections = Array.from(root.querySelectorAll<HTMLElement>("[data-slide-index]"));
    const blockEl = document.getElementById("hud-block")!;
    const iconEl = document.getElementById("hud-icon")!;
    const currentEl = document.getElementById("hud-current")!;
    const progressEl = document.getElementById("progress-fill")!;
    const numberOverlay = document.getElementById("number-overlay")!;
    const numberValue = document.getElementById("number-overlay-value")!;

    // Registry de iconos pre-renderizados por el servidor
    const iconRegistry = new Map<string, string>();
    document
      .querySelectorAll<HTMLElement>("#icon-registry [data-icon]")
      .forEach((el) => {
        const name = el.dataset.icon;
        if (name) iconRegistry.set(name, el.innerHTML);
      });

    const setIcon = (iconName: string) => {
      iconEl.innerHTML = iconRegistry.get(iconName) ?? "";
    };

    createController({
      deckSlug: slug,
      totalSlides: total,
      viewName: "presenter",
      role: "presenter",
      onChange: (i) => {
        sections.forEach((s, idx) => {
          s.style.display = idx === i ? "" : "none";
        });
        currentEl.textContent = String(i + 1);
        progressEl.style.width = `${((i + 1) / total) * 100}%`;
        blockEl.textContent = sections[i].dataset.blockTitle ?? "";
        setIcon(sections[i].dataset.blockIcon ?? "");
      },
      onNumberBuffer: (buffer) => {
        if (buffer) {
          numberValue.textContent = buffer;
          numberOverlay.hidden = false;
        } else {
          numberOverlay.hidden = true;
        }
      },
    });

    // Icono inicial
    setIcon(sections[0]?.dataset.blockIcon ?? "");
  </script>
</Base>
